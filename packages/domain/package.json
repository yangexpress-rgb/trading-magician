{
  "name": "@tm/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./options-fixtures": "./src/options/test-fixtures.ts",
    "./machine-fixtures": "./src/strategy/machine-fixtures.ts",
    "./strategy-text": "./src/strategy/text.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "sp500:update": "node scripts/update-sp500.mjs && prettier --write src/market/sp500-members.ts",
    "groups:update": "node scripts/update-stock-groups.mjs; s=$?; prettier --write src/market/groups; exit $s",
    "groups:history": "node scripts/update-sp500-history.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.11.0"
  }
}

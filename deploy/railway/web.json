{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "sh -c 'pnpm --filter @tm/db db:migrate && pnpm --filter @tm/db db:seed && pnpm --filter @tm/db db:setup-logins'"
    ],
    "startCommand": "pnpm --filter @tm/web start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

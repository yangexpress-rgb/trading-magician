# Names only. Never put real values in this file (Design v1.0 §21).
NODE_ENV=
APP_URL=
LOG_LEVEL=

# Owner connection: migrations and seeding only (pnpm --filter @tm/db db:migrate).
DATABASE_URL=
# Runtime connections, one per database role (see docs/adr/0003-tenant-isolation.md).
DATABASE_APP_URL=
DATABASE_AUTH_URL=
# The worker's login (tm_app plus tm_secrets); see docs/adr/0015-credential-storage.md.
DATABASE_WORKER_URL=

# Local development only: passwords for the login users created by db:setup-logins.
DB_APP_LOGIN_PASSWORD=
DB_AUTH_LOGIN_PASSWORD=
DB_WORKER_LOGIN_PASSWORD=

# Authentication (docs/adr/0004-authentication.md). At least 32 random characters.
BETTER_AUTH_SECRET=

# Provider credential sealing (docs/adr/0015-credential-storage.md). PEM, "\n" for line breaks.
# The web app gets only the public key; only the worker gets the private key.
CREDENTIALS_PUBLIC_KEY=
CREDENTIALS_PRIVATE_KEY=

# Email: "smtp" (default; Mailpit locally on smtp://localhost:1025) or "outbox" (dev/tests).
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_URL=
MAIL_OUTBOX_DIR=

# Worker: health port, and how often the back-test queue, paper runtimes and feed checks run (ms).
WORKER_HEALTH_PORT=
BACKTEST_POLL_MS=
RUNTIME_POLL_MS=
FEED_CHECK_POLL_MS=
# Development and tests only: start the paper runtimes' clock at this instant (ISO 8601).
PAPER_CLOCK_START=

# Integration tests: a connection allowed to create databases and roles.
TEST_DATABASE_URL=
# End-to-end tests: optional path to a pre-installed Chromium.
PW_CHROMIUM_PATH=

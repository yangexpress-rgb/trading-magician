# Names only. Never put real values in this file (Design v1.0 §21).
NODE_ENV=
APP_URL=
LOG_LEVEL=

# Owner connection: migrations and seeding only (pnpm --filter @tm/db db:migrate).
DATABASE_URL=
# Runtime connections, one per database role (see docs/adr/0003-tenant-isolation.md).
DATABASE_APP_URL=
DATABASE_AUTH_URL=
# The worker's login (tm_app plus tm_secrets); see docs/adr/0015-credential-storage.md.
DATABASE_WORKER_URL=

# Local development only: passwords for the login users created by db:setup-logins.
DB_APP_LOGIN_PASSWORD=
DB_AUTH_LOGIN_PASSWORD=
DB_WORKER_LOGIN_PASSWORD=

# Authentication (docs/adr/0004-authentication.md). At least 32 random characters.
BETTER_AUTH_SECRET=

# Provider credential sealing (docs/adr/0015-credential-storage.md). PEM, "\n" for line breaks.
# The web app gets only the public key; only the worker gets the private key.
CREDENTIALS_PUBLIC_KEY=
CREDENTIALS_PRIVATE_KEY=

# Plans (docs/adr/0022-plans-and-limits.md). Tests and staging only: start new workspaces on this plan.
SIGNUP_PLAN=
# Billing (docs/adr/0023-billing-with-stripe.md). Stripe test-mode keys only; the worker needs the secret key too.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tests only: replace Stripe with an in-process stand-in that has its own checkout and portal pages.
BILLING_FAKE=

# Error reports to Sentry, web and worker (docs/adr/0025-production-operations.md). Optional.
SENTRY_DSN=
# Names the environment in reports; defaults to Railway's RAILWAY_ENVIRONMENT_NAME, then NODE_ENV.
SENTRY_ENVIRONMENT=

# Email: "smtp" (default; Mailpit locally on smtp://localhost:1025) or "outbox" (dev/tests).
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_URL=
MAIL_OUTBOX_DIR=

# Worker: health port, and how often the back-test queue, paper runtimes and feed checks run (ms),
# and how often each trading account is valued (seconds).
WORKER_HEALTH_PORT=
BACKTEST_POLL_MS=
RUNTIME_POLL_MS=
FEED_CHECK_POLL_MS=
VALUATION_EVERY_SEC=
# How often the worker marks itself alive for /api/health/system (ms).
HEARTBEAT_MS=
# Development and tests only: start the paper runtimes' clock at this instant (ISO 8601).
PAPER_CLOCK_START=
# Tests only: send Alpaca calls to an in-process fake with made-up symbols (true or false).
ALPACA_FAKE=

# Backup job (deploy/backup, docs/runbooks/backups.md): R2 bucket, its S3 endpoint and an R2 API token.
R2_ENDPOINT=
R2_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_PREFIX=
BACKUP_KEEP_DAYS=

# Integration tests: a connection allowed to create databases and roles.
TEST_DATABASE_URL=
# End-to-end tests: optional path to a pre-installed Chromium.
PW_CHROMIUM_PATH=

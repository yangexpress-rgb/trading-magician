# Names only. Never put real values in this file (Design v1.0 §21).
NODE_ENV=
APP_URL=
LOG_LEVEL=

# Owner connection: migrations and seeding only (pnpm --filter @tm/db db:migrate).
DATABASE_URL=
# Runtime connections, one per database role (see docs/adr/0003-tenant-isolation.md).
DATABASE_APP_URL=
DATABASE_AUTH_URL=

# Local development only: passwords for the login users created by db:setup-logins.
DB_APP_LOGIN_PASSWORD=
DB_AUTH_LOGIN_PASSWORD=

# Integration tests: a connection allowed to create databases and roles.
TEST_DATABASE_URL=
